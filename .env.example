# Supply these through your shell/deployment environment. No automatic .env loading.
HTTP_ADDR=127.0.0.1:8080
SUPABASE_URL=https://your-project.supabase.co
# Issuer and JWKS default to SUPABASE_URL/auth/v1 and its /.well-known/jwks.json.
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
JWKS_CACHE_TTL=5m
JWKS_REFRESH_INTERVAL=10s
AUTH_HTTP_TIMEOUT=5s
SHUTDOWN_TIMEOUT=15s
# Explicit legacy-only mode: algorithms must be HS256 when enabling this.
SUPABASE_ENABLE_LEGACY_HS256=false
# SUPABASE_LEGACY_JWT_SECRET=use-your-project-secret-never-a-publishable-key
# Database, room and WebSocket configuration is added with the relevant phases.
